---
import Layout from '../layouts/Layout.astro';
import Parser from 'rss-parser';

// Curated episode metadata mapping for enhanced display
const episodeMetadata: Record<string, { ep: number; category: string; description: string; duration: string }> = {
	"i6un_awEPYY": {
		ep: 1,
		category: "Architecture",
		description: "Understanding the fundamental differences between OLTP (Transactional) and OLAP (Analytical) systems and how modern lakehouses bridge the gap.",
		duration: "1:54"
	},
	"nNGxRvu3JWs": {
		ep: 2,
		category: "Architecture",
		description: "Comparing Extract-Transform-Load (ETL) and Extract-Load-Transform (ELT) architectural patterns in modern data platforms.",
		duration: "2:01"
	},
	"vX1CdJ1EIrU": {
		ep: 3,
		category: "Storage & Formats",
		description: "Why columnar storage layouts outperform traditional row-based storage formats for analytical workloads.",
		duration: "3:03"
	},
	"qL7d1_JtC3s": {
		ep: 4,
		category: "Architecture",
		description: "Deconstructing the core layers of modern data architecture: storage, file format, table format, catalog, semantic layer, and compute engine.",
		duration: "3:44"
	},
	"uBlmGtFfxE4": {
		ep: 5,
		category: "Architecture",
		description: "Exploring vendor lock-in and how open table formats solve the interoperability bottleneck across analytical compute engines.",
		duration: "2:51"
	},
	"P0KGOhG3X0M": {
		ep: 6,
		category: "Architecture",
		description: "A clear definition of the Data Lakehouse: combining data warehouse ACID reliability with data lake scale and flexibility.",
		duration: "3:01"
	},
	"en6jEZVJaxg": {
		ep: 7,
		category: "Storage & Formats",
		description: "Deep dive into Apache Arrow, the in-memory columnar data standard enabling zero-copy data transport and high-speed processing.",
		duration: "3:45"
	},
	"9754Qol0xqo": {
		ep: 8,
		category: "Storage & Formats",
		description: "Understanding Apache Parquet, its row group structure, column chunks, compression, and why it is the default format for lakehouses.",
		duration: "2:49"
	},
	"Su1EnVPM7eU": {
		ep: 9,
		category: "Table Formats & Catalogs",
		description: "Introduction to Apache Iceberg: metadata layers, snapshot logs, manifest files, schema evolution, and ACID transactions.",
		duration: "2:59"
	},
	"BXVI9aZgfdY": {
		ep: 10,
		category: "Table Formats & Catalogs",
		description: "Exploring Apache Polaris (Incubating), the open-source REST catalog for Apache Iceberg providing multi-engine access control and governance.",
		duration: "2:24"
	},
	"fofWSo_43RM": {
		ep: 11,
		category: "AI & Machine Learning",
		description: "What machine learning actually is: learning patterns from data instead of hand-coding rules, and how training data quality shapes the resulting model.",
		duration: "1:31"
	},
	"E23misg4HD8": {
		ep: 12,
		category: "AI & Machine Learning",
		description: "Understanding Large Language Models: what they are, how they are trained on massive text corpora, and how they predict language to generate responses.",
		duration: "1:19"
	},
	"jm5XpxyVl1c": {
		ep: 13,
		category: "AI & Machine Learning",
		description: "Breaking down tokens and vectors — how text is split into tokens and represented as embeddings that capture meaning for search and AI workloads.",
		duration: "3:32"
	},
	"tOC-3M6hx7k": {
		ep: 14,
		category: "AI & Machine Learning",
		description: "What a context window is, why it limits how much information a model can consider at once, and what that means for prompting and retrieval design.",
		duration: "2:37"
	},
	"2TNyny4MKeY": {
		ep: 15,
		category: "AI & Machine Learning",
		description: "Prompt engineering fundamentals: how framing, context, and instructions shape the quality and reliability of the output you get from a language model.",
		duration: "2:18"
	}
};

const parser = new Parser();
let videos = [];

try {
	const feed = await parser.parseURL('https://www.youtube.com/feeds/videos.xml?playlist_id=PLMJNIZCS9e2s');
	videos = feed.items.map((item, idx) => {
		const videoId = item.id.replace('yt:video:', '');
		const meta = episodeMetadata[videoId] || {
			ep: idx + 1,
			category: "Data & AI",
			description: item.contentSnippet ? item.contentSnippet.substring(0, 160) + '...' : 'Explore concepts in data engineering, Apache Iceberg, and AI architecture.',
			duration: ""
		};
		return {
			id: videoId,
			title: item.title,
			link: item.link,
			date: new Date(item.pubDate || item.isoDate).toLocaleDateString(),
			ep: meta.ep,
			category: meta.category,
			description: meta.description,
			duration: meta.duration
		};
	});
} catch (error) {
	console.error('Error fetching playlist RSS feed:', error);
	// Fallback to static items if RSS fails
	videos = Object.entries(episodeMetadata).map(([id, meta]) => ({
		id,
		title: `Episode #${meta.ep} - ${meta.description.split('.')[0]}`,
		link: `https://www.youtube.com/watch?v=${id}&list=PLMJNIZCS9e2s`,
		date: "2026",
		ep: meta.ep,
		category: meta.category,
		description: meta.description,
		duration: meta.duration
	}));
}

const categories = ["All", ...new Set(videos.map(v => v.category))];
---

<Layout 
	title="The Lakehouse and AI with Alex Merced Show | Video Gallery" 
	description="Watch episodes of 'The Lakehouse and AI with Alex Merced Show' covering Data Lakehouse architecture, Apache Iceberg, Apache Arrow, Parquet, and AI concepts."
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "VideoGallery",
			"name": "The Lakehouse and AI with Alex Merced Show",
			"description": "Video series covering Data Lakehouses, Apache Iceberg, Apache Arrow, Apache Parquet, Apache Polaris, and AI architecture.",
			"url": "https://alexmerceddata.com/lakehouse-ai-show",
			"itemListElement": videos.map((v, i) => ({
				"@type": "ListItem",
				"position": i + 1,
				"item": {
					"@type": "VideoObject",
					"name": v.title,
					"description": v.description,
					"thumbnailUrl": `https://img.youtube.com/vi/${v.id}/hqdefault.jpg`,
					"embedUrl": `https://www.youtube.com/embed/${v.id}`,
					"contentUrl": v.link,
					"uploadDate": new Date().toISOString()
				}
			}))
		})} />
	</Fragment>

	<div class="container page-header">
		<span class="series-badge">Official Video Series</span>
		<h1>The Lakehouse and AI Show</h1>
		<p>Bite-sized, authoritative video deep dives into Data Lakehouse architecture, open table formats, Apache Iceberg, Apache Arrow, and AI data systems by Alex Merced.</p>

		<div class="header-actions">
			<a href="https://www.youtube.com/playlist?list=PLMJNIZCS9e2s" target="_blank" rel="noopener noreferrer" class="button primary">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
				Subscribe on YouTube
			</a>
		</div>

		<div class="controls-container">
			<div class="search-box">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				<input type="text" id="videoSearch" placeholder="Search episodes by topic or keyword (e.g. Parquet, Iceberg, Arrow)..." />
			</div>
			<div class="filter-tabs" id="categoryFilter">
				{categories.map((cat, idx) => (
					<button class={`filter-btn ${idx === 0 ? 'active' : ''}`} data-category={cat}>{cat}</button>
				))}
			</div>
		</div>
	</div>

	<div class="container">
		<div class="video-grid" id="videoGrid">
			{videos.map((video) => (
				<div 
					class="video-card card" 
					data-category={video.category}
					data-title={video.title.toLowerCase()}
					data-description={video.description.toLowerCase()}
					data-video-id={video.id}
					data-video-title={video.title}
					data-video-desc={video.description}
					data-video-cat={video.category}
					data-video-duration={video.duration}
					data-video-link={video.link}
				>
					<div class="thumbnail-wrapper">
						<img src={`https://img.youtube.com/vi/${video.id}/hqdefault.jpg`} alt={video.title} loading="lazy" />
						<div class="thumbnail-overlay">
							<span class="play-btn">
								<svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
								Play Episode
							</span>
						</div>
						{video.duration && <span class="duration-badge">{video.duration}</span>}
						{video.ep && <span class="ep-badge">Ep #{video.ep}</span>}
					</div>
					<div class="card-info">
						<span class="category-badge">{video.category}</span>
						<h3>{video.title}</h3>
						<p>{video.description}</p>
					</div>
				</div>
			))}
		</div>

		<div id="noResults" class="no-results" style="display: none;">
			<p>No episodes found matching your search query.</p>
		</div>
	</div>

	<!-- Interactive Video Player Modal -->
	<div id="videoModal" class="video-modal" aria-hidden="true">
		<div class="modal-backdrop" id="modalBackdrop"></div>
		<div class="modal-content card">
			<button class="modal-close" id="modalClose" aria-label="Close modal">&times;</button>
			<div class="modal-body">
				<div class="video-player-container">
					<iframe 
						id="modalIframe" 
						src="" 
						title="YouTube Video Player" 
						frameborder="0" 
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
						allowfullscreen
					></iframe>
				</div>
				<div class="modal-details">
					<div class="modal-meta">
						<span id="modalCategory" class="category-badge"></span>
						<span id="modalDuration" class="duration-badge-inline"></span>
					</div>
					<h2 id="modalTitle"></h2>
					<p id="modalDesc"></p>
					<div class="modal-actions">
						<a id="modalYoutubeLink" href="#" target="_blank" rel="noopener noreferrer" class="button primary">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
							Watch on YouTube
						</a>
						<button id="modalCloseBtn" class="button">Close</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	// Search and Filtering Logic
	const searchInput = document.getElementById('videoSearch') as HTMLInputElement;
	const filterBtns = document.querySelectorAll('.filter-btn');
	const cards = document.querySelectorAll('.video-card');
	const noResults = document.getElementById('noResults');

	let activeCategory = 'All';

	function filterVideos() {
		const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
		let visibleCount = 0;

		cards.forEach((card) => {
			const cat = card.getAttribute('data-category');
			const title = card.getAttribute('data-title') || '';
			const desc = card.getAttribute('data-description') || '';

			const matchesCategory = activeCategory === 'All' || cat === activeCategory;
			const matchesQuery = query === '' || title.includes(query) || desc.includes(query);

			if (matchesCategory && matchesQuery) {
				(card as HTMLElement).style.display = 'flex';
				visibleCount++;
			} else {
				(card as HTMLElement).style.display = 'none';
			}
		});

		if (noResults) {
			noResults.style.display = visibleCount === 0 ? 'block' : 'none';
		}
	}

	if (searchInput) {
		searchInput.addEventListener('input', filterVideos);
	}

	filterBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			filterBtns.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			activeCategory = btn.getAttribute('data-category') || 'All';
			filterVideos();
		});
	});

	// Video Modal Logic
	const modal = document.getElementById('videoModal');
	const backdrop = document.getElementById('modalBackdrop');
	const closeBtn = document.getElementById('modalClose');
	const closeBtnBottom = document.getElementById('modalCloseBtn');
	const modalIframe = document.getElementById('modalIframe') as HTMLIFrameElement;
	const modalTitle = document.getElementById('modalTitle');
	const modalDesc = document.getElementById('modalDesc');
	const modalCategory = document.getElementById('modalCategory');
	const modalDuration = document.getElementById('modalDuration');
	const modalYoutubeLink = document.getElementById('modalYoutubeLink') as HTMLAnchorElement;

	function openModal(id: string, title: string, desc: string, cat: string, duration: string, link: string) {
		if (!modal || !modalIframe || !modalTitle || !modalDesc || !modalCategory || !modalYoutubeLink) return;

		modalIframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
		modalTitle.textContent = title;
		modalDesc.textContent = desc;
		modalCategory.textContent = cat;
		if (modalDuration) {
			modalDuration.textContent = duration ? `Duration: ${duration}` : '';
		}
		modalYoutubeLink.href = link;

		modal.classList.add('active');
		modal.setAttribute('aria-hidden', 'false');
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (!modal || !modalIframe) return;
		modalIframe.src = '';
		modal.classList.remove('active');
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	cards.forEach((card) => {
		card.addEventListener('click', () => {
			const id = card.getAttribute('data-video-id') || '';
			const title = card.getAttribute('data-video-title') || '';
			const desc = card.getAttribute('data-video-desc') || '';
			const cat = card.getAttribute('data-video-cat') || '';
			const duration = card.getAttribute('data-video-duration') || '';
			const link = card.getAttribute('data-video-link') || '#';
			openModal(id, title, desc, cat, duration, link);
		});
	});

	if (closeBtn) closeBtn.addEventListener('click', closeModal);
	if (closeBtnBottom) closeBtnBottom.addEventListener('click', closeModal);
	if (backdrop) backdrop.addEventListener('click', closeModal);

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && modal?.classList.contains('active')) {
			closeModal();
		}
	});
</script>

<style>
	.series-badge {
		display: inline-block;
		background-color: rgba(100, 255, 218, 0.1);
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.3rem 0.8rem;
		border-radius: 9999px;
		margin-bottom: 1rem;
		border: 1px solid rgba(100, 255, 218, 0.2);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.page-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.page-header h1 {
		font-size: 3.2rem;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.page-header p {
		font-size: 1.2rem;
		max-width: 800px;
		margin: 0 auto 2rem;
		color: var(--text-muted);
	}

	.header-actions {
		display: flex;
		justify-content: center;
		margin-bottom: 2.5rem;
	}

	.header-actions .button svg {
		margin-right: 0.5rem;
		vertical-align: middle;
	}

	/* Controls */
	.controls-container {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: center;
		max-width: 900px;
		margin: 0 auto;
	}

	.search-box {
		position: relative;
		width: 100%;
		max-width: 650px;
	}

	.search-box svg {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted);
	}

	.search-box input {
		width: 100%;
		padding: 0.9rem 1rem 0.9rem 3rem;
		border-radius: 8px;
		border: 1px solid var(--secondary);
		background-color: var(--primary);
		color: var(--text);
		font-size: 1.05rem;
		outline: none;
		transition: border-color 0.3s, box-shadow 0.3s;
	}

	.search-box input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 15px rgba(100, 255, 218, 0.15);
	}

	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.filter-btn {
		background-color: var(--secondary);
		color: var(--text-muted);
		border: 1px solid rgba(100, 255, 218, 0.1);
		padding: 0.5rem 1.25rem;
		border-radius: 9999px;
		font-size: 0.95rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.filter-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
		background-color: rgba(100, 255, 218, 0.05);
	}

	.filter-btn.active {
		background-color: var(--accent);
		color: var(--primary);
		border-color: var(--accent);
		font-weight: 600;
	}

	/* Video Grid */
	.video-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 2rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.video-card {
		display: flex;
		flex-direction: column;
		cursor: pointer;
		padding: 0;
		overflow: hidden;
		border: 1px solid rgba(100, 255, 218, 0.1);
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.video-card:hover {
		transform: translateY(-6px);
		border-color: var(--accent);
		box-shadow: 0 12px 30px -10px rgba(100, 255, 218, 0.2);
	}

	.thumbnail-wrapper {
		position: relative;
		width: 100%;
		aspect-ratio: 16/9;
		overflow: hidden;
		background-color: #050d1a;
	}

	.thumbnail-wrapper img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.video-card:hover .thumbnail-wrapper img {
		transform: scale(1.05);
	}

	.thumbnail-overlay {
		position: absolute;
		inset: 0;
		background: rgba(10, 25, 47, 0.75);
		backdrop-filter: blur(3px);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.video-card:hover .thumbnail-overlay {
		opacity: 1;
	}

	.play-btn {
		color: var(--accent);
		font-weight: 600;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 1rem;
		border: 1px solid var(--accent);
		padding: 0.6rem 1.2rem;
		border-radius: 4px;
		background: rgba(2, 12, 27, 0.85);
	}

	.duration-badge {
		position: absolute;
		bottom: 0.75rem;
		right: 0.75rem;
		background: rgba(2, 12, 27, 0.85);
		color: var(--text);
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.ep-badge {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		background: var(--accent);
		color: var(--primary);
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		text-transform: uppercase;
	}

	.card-info {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.category-badge {
		align-self: flex-start;
		background-color: rgba(100, 255, 218, 0.1);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.25rem 0.75rem;
		border-radius: 4px;
		margin-bottom: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.card-info h3 {
		font-size: 1.25rem;
		color: var(--text);
		margin-bottom: 0.75rem;
		line-height: 1.35;
		transition: color 0.3s ease;
	}

	.video-card:hover .card-info h3 {
		color: var(--accent);
	}

	.card-info p {
		color: var(--text-muted);
		font-size: 0.95rem;
		line-height: 1.5;
		margin: 0;
		flex: 1;
	}

	.no-results {
		text-align: center;
		padding: 4rem 1rem;
		color: var(--text-muted);
		font-size: 1.2rem;
	}

	/* Video Modal */
	.video-modal {
		position: fixed;
		inset: 0;
		z-index: 1000;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
		padding: 2rem;
	}

	.video-modal.active {
		opacity: 1;
		pointer-events: auto;
	}

	.modal-backdrop {
		position: absolute;
		inset: 0;
		background-color: rgba(2, 12, 27, 0.92);
		backdrop-filter: blur(8px);
	}

	.modal-content {
		position: relative;
		z-index: 1001;
		max-width: 1000px;
		width: 100%;
		max-height: 90vh;
		overflow-y: auto;
		background-color: var(--primary);
		border: 1px solid var(--accent);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
		border-radius: 12px;
		padding: 2rem;
	}

	.modal-close {
		position: absolute;
		top: 1rem;
		right: 1.25rem;
		background: none;
		border: none;
		color: var(--text-muted);
