---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Alex Merced | Apache Iceberg & Data Lakehouse Author, Educator" description="Learn about Alex Merced, Head of Developer Relations at Dremio, educator, and author of 'Apache Iceberg: The Definitive Guide' specializing in Data Lakehouses, AI, and Apache Iceberg.">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "VideoObject",
			"name": "Who is Alex Merced?",
			"description": "Who is Alex Merced — a short introduction",
			"thumbnailUrl": "https://alexmerceddata.com/who-is-alex-merced.jpg",
			"uploadDate": "2026-08-05T00:00:00+00:00",
			"duration": "PT48S",
			"contentUrl": "https://alexmerceddata.com/who-is-alex-merced.mp4",
			"embedUrl": "https://alexmerceddata.com/#brand-video",
			"about": { "@id": "https://alexmerceddata.com/#alexmerced" },
			"author": { "@id": "https://alexmerceddata.com/#alexmerced" },
			"publisher": { "@id": "https://alexmerceddata.com/#organization" }
		})} />
	</Fragment>

	<div class="hero">
		<svg class="hero-dag" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
			<defs>
				<linearGradient id="amd-fade" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
					<stop offset="0" stop-color="#fff"/>
					<stop offset="0.20" stop-color="#fff"/>
					<stop offset="0.33" stop-color="#000"/>
					<stop offset="0.67" stop-color="#000"/>
					<stop offset="0.80" stop-color="#fff"/>
					<stop offset="1" stop-color="#fff"/>
				</linearGradient>
				<mask id="amd-mask"><rect width="1440" height="800" fill="url(#amd-fade)"/></mask>
			</defs>

			<g mask="url(#amd-mask)">
				<!-- Pipeline edges: sources fan in, transforms fan out -->
				<g class="dag-edges">
					<path d="M40 210 C160 210 180 310 300 310"/>
					<path d="M40 390 C160 390 180 310 300 310"/>
					<path d="M40 570 C160 570 180 490 300 490"/>
					<path d="M300 310 C400 310 400 400 500 400"/>
					<path d="M300 490 C400 490 400 400 500 400"/>
					<path d="M1400 230 C1280 230 1260 340 1140 340"/>
					<path d="M1400 420 C1280 420 1260 340 1140 340"/>
					<path d="M1400 600 C1280 600 1260 520 1140 520"/>
					<path d="M1140 340 C1040 340 1040 430 940 430"/>
					<path d="M1140 520 C1040 520 1040 430 940 430"/>
				</g>

				<!-- Records moving through the pipeline -->
				<g class="dag-flows">
					<path pathLength="100" d="M40 210 C160 210 180 310 300 310" style="animation-duration:6s"/>
					<path pathLength="100" d="M40 390 C160 390 180 310 300 310" style="animation-duration:7.5s;animation-delay:-2s"/>
					<path pathLength="100" d="M300 310 C400 310 400 400 500 400" style="animation-duration:5s;animation-delay:-3s"/>
					<path pathLength="100" d="M1400 420 C1280 420 1260 340 1140 340" style="animation-duration:6.5s;animation-delay:-1s"/>
					<path pathLength="100" d="M1400 600 C1280 600 1260 520 1140 520" style="animation-duration:8s;animation-delay:-4s"/>
					<path pathLength="100" d="M1140 520 C1040 520 1040 430 940 430" style="animation-duration:5.5s;animation-delay:-2.5s"/>
				</g>

				<!-- Sources, transforms and sinks -->
				<g class="dag-nodes">
					<rect x="26" y="196" width="28" height="28" rx="3"/>
					<rect x="26" y="376" width="28" height="28" rx="3"/>
					<rect x="26" y="556" width="28" height="28" rx="3"/>
					<rect x="1386" y="216" width="28" height="28" rx="3"/>
					<rect x="1386" y="406" width="28" height="28" rx="3"/>
					<rect x="1386" y="586" width="28" height="28" rx="3"/>
				</g>
				<g class="dag-nodes dag-nodes--accent">
					<rect x="284" y="294" width="32" height="32" rx="4" style="animation-delay:-0.5s"/>
					<rect x="284" y="474" width="32" height="32" rx="4" style="animation-delay:-1.8s"/>
					<rect x="486" y="386" width="28" height="28" rx="4" style="animation-delay:-3.1s"/>
					<rect x="1124" y="324" width="32" height="32" rx="4" style="animation-delay:-2.4s"/>
					<rect x="1124" y="504" width="32" height="32" rx="4" style="animation-delay:-0.9s"/>
					<rect x="926" y="416" width="28" height="28" rx="4" style="animation-delay:-3.7s"/>
				</g>
			</g>
		</svg>
		<div class="container hero-content">
			<div class="hero-image">
				<img src="/images/alexmercedpic.jpg" alt="Alex Merced" />
			</div>
			<div class="hero-text">
				<h1>Alex Merced</h1>
				<h2 class="subtitle">Data Lakehouse & AI Thought Leader</h2>
				<p class="bio">
					Promoting empowerment through education, technology, and optimism. 
					Alex is a Developer Advocate, Educator, and Author who has specialized in data engineering, open source (Apache Iceberg, Apache Polaris), and developer education.
				</p>
				<div class="hero-actions">
					<a href="/books" class="button primary">Explore My Books</a>
					<a href="/videos" class="button">Watch Videos</a>
				</div>
			</div>
		</div>
	</div>

	<section class="container video-section" id="brand-video">
		<div class="video-header">
			<span class="video-label">Introduction</span>
			<h2>Who is Alex Merced?</h2>
			<p>A short introduction — the author, speaker, podcaster, and educator behind the work.</p>
		</div>
		<figure class="video-figure">
			<div class="video-frame">
				<video
					controls
					preload="metadata"
					playsinline
					poster="/who-is-alex-merced.jpg"
					width="1920"
					height="1080"
				>
					<source src="/who-is-alex-merced.mp4" type="video/mp4" />
					Your browser does not support the video tag.
					<a href="/who-is-alex-merced.mp4">Download the video</a>.
				</video>
			</div>
			<figcaption>
				48 seconds · Press play (with sound) for the short version. ·
				<a href="/who-is-alex-merced.mp4" download>Download the video</a>
			</figcaption>
		</figure>
	</section>

	<section class="container about-section">
		<div class="about-grid">
			<div class="card">
				<h3>Developer Advocacy</h3>
				<p>Serving as Head of Developer Relations at Dremio, focusing on data engineering and open-source tech. Frequent speaker at events like Data Council, Confluent Current, and DataEngBytes.</p>
			</div>
			<div class="card">
				<h3>Authorship</h3>
				<p>Author of "Apache Iceberg: The Definitive Guide", "Apache Polaris: The Definitive Guide", and "Architecting an Apache Iceberg Lakehouse", along with 30+ other books on tech, economics, and fiction.</p>
			</div>
			<div class="card">
				<h3>Educator</h3>
				<p>With over a decade of teaching economics and finance in NYC, and extensive experience instructing software engineering and web development.</p>
			</div>
		</div>
	</section>

	<section class="container kb-section">
		<div class="kb-feature card">
			<h2>📚 Knowledge Base</h2>
			<p>Explore a free library of 200+ in-depth articles covering Apache Iceberg, open table formats, data lakehouse architecture, data platforms (Dremio, Snowflake, Databricks, Trino), and AI engineering concepts — written as authoritative references for data engineers and architects.</p>
			<a href="/knowledge" class="button primary">Browse the Knowledge Base</a>
		</div>
	</section>

	<section class="container cta-section">
		<div class="cta-grid">
			<div class="card cta-card">
				<h3>📺 Lakehouse & AI Show</h3>
				<p>Watch bite-sized video deep dives into Data Lakehouse architecture, open table formats, Apache Iceberg, and AI data systems.</p>
				<a href="/lakehouse-ai-show" class="button primary">Watch the Show</a>
			</div>
			<div class="card cta-card">
				<h3>🎙️ Listen to the Podcast</h3>
				<p>Join Alex Merced for deep dives into Data Engineering, open-source technology, and the future of the Data Lakehouse.</p>
				<a href="https://open.spotify.com/show/2PRDrWVpgDvKxN6n1oUsJF?si=369a437441814254" target="_blank" rel="noopener noreferrer" class="button">Listen on Spotify</a>
			</div>
			<div class="card cta-card">
				<h3>📧 Read the Newsletter</h3>
				<p>Get the latest insights, tutorials, and architectural patterns delivered directly to your inbox every week.</p>
				<a href="https://amdatalakehouse.substack.com/" target="_blank" rel="noopener noreferrer" class="button">Subscribe on Substack</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding: 6rem 0;
		position: relative;
		overflow: hidden;
		background: radial-gradient(circle at top right, rgba(100, 255, 218, 0.1), transparent 40%),
					linear-gradient(to bottom, var(--primary), var(--bg));
		border-bottom: 1px solid var(--secondary);
	}

	/* Pipeline DAG backdrop — desktop only */
	.hero-dag { display: none; }

	@media (min-width: 1100px) {
		.hero-dag {
			display: block;
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			pointer-events: none;
			z-index: 0;
		}
	}

	.dag-edges path {
		fill: none;
		stroke: var(--text-muted);
		stroke-width: 1;
		opacity: 0.3;
	}

	.dag-flows path {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 10 90;
		animation: dagFlow 6s linear infinite;
	}

	.dag-nodes rect {
		fill: none;
		stroke: var(--text-muted);
		stroke-width: 1.5;
		opacity: 0.4;
	}

	.dag-nodes--accent rect {
		stroke: var(--accent);
		opacity: 0.85;
		animation: dagNode 5s ease-in-out infinite;
	}

	@keyframes dagFlow {
		from { stroke-dashoffset: 100; }
		to { stroke-dashoffset: 0; }
	}

	@keyframes dagNode {
		0%, 100% { opacity: 0.35; }
		50% { opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.dag-flows path, .dag-nodes--accent rect { animation: none; }
		.dag-flows path { stroke-dashoffset: 55; }
		.dag-nodes--accent rect { opacity: 0.7; }
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 800px;
	}

	.hero h1 {
		font-size: 4rem;
		font-weight: 800;
		margin-bottom: 0.5rem;
		background: linear-gradient(to right, var(--text), var(--accent));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.hero-image {
		margin-bottom: 2rem;
	}

	.hero-image img {
		width: 200px;
		height: 200px;
		border-radius: 50%;
		object-fit: cover;
		border: 4px solid var(--accent);
		box-shadow: 0 10px 30px -10px rgba(100, 255, 218, 0.3);
	}

	.subtitle {
		color: var(--accent);
		font-size: 1.5rem;
		font-weight: 500;
		margin-bottom: 1.5rem;
	}

	.bio {
		font-size: 1.2rem;
		margin-bottom: 2.5rem;
		color: var(--text-muted);
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.video-section {
		padding: 4rem 1.5rem 1rem;
	}

	.video-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 2.5rem;
	}

	.video-label {
		display: inline-block;
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	.video-header h2 {
		font-size: 2.25rem;
		margin-bottom: 0.75rem;
	}

	.video-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin: 0;
	}

	.video-figure {
		max-width: 900px;
		margin: 0 auto;
	}

	.video-frame {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--secondary);
		background-color: var(--primary);
		box-shadow: 0 20px 50px -20px rgba(2, 12, 27, 0.9);
	}

	.video-frame video {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		background-color: var(--primary);
	}

	.video-figure figcaption {
		margin-top: 1rem;
		text-align: center;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	.video-figure figcaption a {
		color: var(--accent);
	}

	.about-section {
		padding: 5rem 1.5rem;
	}

	.about-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
	}

	.card h3 {
		color: var(--accent);
		margin-bottom: 1rem;
		font-size: 1.25rem;
	}

	.kb-section {
		padding: 0 1.5rem 3rem;
	}

	.kb-feature {
		text-align: center;
		padding: 3rem 2rem;
		background: linear-gradient(to bottom, var(--secondary), rgba(2,12,27,0.5));
		border-color: var(--accent);
		max-width: 800px;
		margin: 0 auto;
	}

	.kb-feature h2 {
		color: var(--accent);
		font-size: 2rem;
		margin-bottom: 1rem;
	}

	.kb-feature p {
		font-size: 1.15rem;
		margin-bottom: 2rem;
	}

	.cta-section {
		padding: 2rem 1.5rem 5rem;
	}

	.cta-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.cta-card {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cta-card h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}

	.cta-card p {
		margin-bottom: 1.5rem;
		flex-grow: 1;
	}

	@media (max-width: 768px) {
		.hero h1 {
			font-size: 3rem;
		}
		.hero-actions {
			flex-direction: column;
		}
	}
</style>
