---
import Layout from '../layouts/Layout.astro';
import bookData from '../data/books.json';

// Flagship titles come from the entity layer (src/data/books.json is generated).
const flagshipBooks = bookData.books.filter((b) => b.flagship);
const bookCount = bookData.books.length;

const projectUpdates = [
	{ name: 'SencilloDB', version: '0.8.0', kind: 'Embedded data', status: 'Published on npm', description: 'A dependency-free embedded JSON document store with typed schemas, hardened transactions, atomic persistence, checksummed logs, diagnostics, repair, and selective shard writes.', href: 'https://github.com/AlexMercedCoder/SencilloDB' },
	{ name: 'IceFrame', version: '0.13.0 / 0.14.0 dev', kind: 'Apache Iceberg', status: 'PyPI stable / development', description: 'A DataFrame-style Iceberg library. The 0.14 development line adds MCP 2.1, complete typing, stronger async and ingestion correctness, query explain, CDC, packaging, and security hardening.', href: 'https://github.com/AlexMercedCoder/iceframe' },
	{ name: 'Pangolin', version: '0.8.0', kind: 'Lakehouse catalog', status: 'Pre-1.0 release', description: 'A Rust Iceberg REST catalog with multi-tenancy, branching, RBAC, OIDC, encrypted warehouse credentials, audit logging, a management UI, two CLIs, and a Python SDK.', href: 'https://github.com/AlexMercedCoder/Pangolin' },
	{ name: 'MagAgent', version: '1.4.0', kind: 'Memory-first harness', status: 'Published on PyPI', description: 'A memory-first personal agent that remembers you across sessions in Git-backed Markdown you can review. Version 1.4.0 adds per-run memory evidence, review-gated team memory, and expiring approval grants.', href: 'https://github.com/AlexMercedCoder/MagAgent' },
	{ name: 'Mag Command Center', version: '1.0.0', kind: 'Desktop workspace', status: 'First stable release', description: 'The desktop cockpit for MagAgent, with runs, approvals, graphs, and memory in one window. Packaged for Linux, macOS, and Windows with unsigned installers. Requires MagAgent 1.4.0.', href: 'https://github.com/AlexMercedCoder/MagCommandCenter/releases/tag/v1.0.0' },
	{ name: 'MagGraph', version: '0.4.1', kind: 'Agent memory', status: 'Pre-1.0 release', description: 'Graph-shaped agent memory stored as Markdown in Git, with search, backlinks, recall bundles, and Python bindings over a Rust core.', href: 'https://github.com/AlexMercedCoder/MagGraph' },
	{ name: 'Loro', version: '0.22.0', kind: 'Governed harness', status: 'Published on PyPI', description: 'The governed agent harness for data and platform teams, with verified identity, tamper-evident audit, and lakehouse-native tools. Version 0.22.0 adds multi-turn context with audited compaction plus experimental OIDC sign-in, multi-user mode, a container sandbox, and run evidence export.', href: 'https://github.com/alexmerced-oss/loro' },
	{ name: 'Merced AI', version: '0.8.0', kind: 'Agent broker', status: 'Published on PyPI', description: 'One portable agent identity across the harnesses you already use, with honest reports of what each one drops. Version 0.8.0 adds ACP client and server support, worktree-per-bot group runs, cross-harness evals, and an experimental A2A endpoint.', href: 'https://github.com/AlexMercedCoder/merced-ai' },
	{ name: 'Open Agent Profile', version: '1.0.5', kind: 'Open specification', status: 'OAP document 1.0', description: 'Portable agent identity, authority, context, memory, and state deltas, with interoperable support libraries for Python, TypeScript, Go, Rust, and Java.', href: 'https://github.com/alexmerced-oss/open-agent-profile' },
	{ name: 'Agentic Graph Specification', version: '1.0.4', kind: 'Open specification', status: 'AGS document 1.0', description: 'Portable bounded agentic work graphs with typed inputs and outputs, budgets, permissions, success criteria, planning, and shared support libraries across five languages.', href: 'https://github.com/AlexMercedCoder/agentic-graph-spec' },
	{ name: 'Agent Approval Interchange Specification', version: '0.2.0', kind: 'Open specification', status: 'AAIS document 1.0', description: 'Exact, durable, transport-neutral human approvals for agent actions. The Python support library is at 0.2.0 and adds a shared durable file store; the TypeScript, Go, Rust, and Java libraries are at 0.1.0.', href: 'https://github.com/alexmerced-oss/agent-approval-interchange-spec' },
];
---

<Layout title="Alex Merced's Data and AI Work | Talks, Books and Videos" description="Talks, the Lakehouse and AI Show, books, videos, and writing by Alex Merced on the open lakehouse, Apache Iceberg, and agentic AI. His bio lives at alexmerced.com.">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "Current open source projects by Alex Merced",
			"numberOfItems": projectUpdates.length,
			"itemListElement": projectUpdates.map((project, index) => ({
				"@type": "ListItem",
				"position": index + 1,
				"item": { "@type": "SoftwareSourceCode", "name": project.name, "softwareVersion": project.version, "description": project.description, "codeRepository": project.href }
			}))
		})} />
	</Fragment>

	<div class="hero">
		<svg class="hero-dag" viewBox="0 0 1440 800" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
			<defs>
				<linearGradient id="amd-fade" x1="0" y1="0" x2="1440" y2="0" gradientUnits="userSpaceOnUse">
					<stop offset="0" stop-color="#fff"/>
					<stop offset="0.20" stop-color="#fff"/>
					<stop offset="0.33" stop-color="#000"/>
					<stop offset="0.67" stop-color="#000"/>
					<stop offset="0.80" stop-color="#fff"/>
					<stop offset="1" stop-color="#fff"/>
				</linearGradient>
				<mask id="amd-mask"><rect width="1440" height="800" fill="url(#amd-fade)"/></mask>
			</defs>

			<g mask="url(#amd-mask)">
				<!-- Pipeline edges: sources fan in, transforms fan out -->
				<g class="dag-edges">
					<path d="M40 210 C160 210 180 310 300 310"/>
					<path d="M40 390 C160 390 180 310 300 310"/>
					<path d="M40 570 C160 570 180 490 300 490"/>
					<path d="M300 310 C400 310 400 400 500 400"/>
					<path d="M300 490 C400 490 400 400 500 400"/>
					<path d="M1400 230 C1280 230 1260 340 1140 340"/>
					<path d="M1400 420 C1280 420 1260 340 1140 340"/>
					<path d="M1400 600 C1280 600 1260 520 1140 520"/>
					<path d="M1140 340 C1040 340 1040 430 940 430"/>
					<path d="M1140 520 C1040 520 1040 430 940 430"/>
				</g>

				<!-- Records moving through the pipeline -->
				<g class="dag-flows">
					<path pathLength="100" d="M40 210 C160 210 180 310 300 310" style="animation-duration:6s"/>
					<path pathLength="100" d="M40 390 C160 390 180 310 300 310" style="animation-duration:7.5s;animation-delay:-2s"/>
					<path pathLength="100" d="M300 310 C400 310 400 400 500 400" style="animation-duration:5s;animation-delay:-3s"/>
					<path pathLength="100" d="M1400 420 C1280 420 1260 340 1140 340" style="animation-duration:6.5s;animation-delay:-1s"/>
					<path pathLength="100" d="M1400 600 C1280 600 1260 520 1140 520" style="animation-duration:8s;animation-delay:-4s"/>
					<path pathLength="100" d="M1140 520 C1040 520 1040 430 940 430" style="animation-duration:5.5s;animation-delay:-2.5s"/>
				</g>

				<!-- Sources, transforms and sinks -->
				<g class="dag-nodes">
					<rect x="26" y="196" width="28" height="28" rx="3"/>
					<rect x="26" y="376" width="28" height="28" rx="3"/>
					<rect x="26" y="556" width="28" height="28" rx="3"/>
					<rect x="1386" y="216" width="28" height="28" rx="3"/>
					<rect x="1386" y="406" width="28" height="28" rx="3"/>
					<rect x="1386" y="586" width="28" height="28" rx="3"/>
				</g>
				<g class="dag-nodes dag-nodes--accent">
					<rect x="284" y="294" width="32" height="32" rx="4" style="animation-delay:-0.5s"/>
					<rect x="284" y="474" width="32" height="32" rx="4" style="animation-delay:-1.8s"/>
					<rect x="486" y="386" width="28" height="28" rx="4" style="animation-delay:-3.1s"/>
					<rect x="1124" y="324" width="32" height="32" rx="4" style="animation-delay:-2.4s"/>
					<rect x="1124" y="504" width="32" height="32" rx="4" style="animation-delay:-0.9s"/>
					<rect x="926" y="416" width="28" height="28" rx="4" style="animation-delay:-3.7s"/>
				</g>
			</g>
		</svg>
		<div class="container hero-content">
			<div class="hero-text">
				<span class="video-label">AlexMercedData</span>
				<h1>Alex Merced's data and AI work</h1>
				<p class="subtitle">Talks, the Lakehouse and AI Show, books, videos, and writing on the open lakehouse, Apache Iceberg, and agentic AI.</p>
				<p class="bio">This site collects the work. For who Alex is, his background, and his press kit, go to <a href="https://alexmerced.com">alexmerced.com</a>.</p>
				<div class="hero-actions">
					<a href="/lakehouse-ai-show/" class="button primary">Watch the show</a>
					<a href="#books" class="button">Browse the books</a>
				</div>
			</div>
		</div>
	</div>

	<nav class="container jump-links" aria-label="On this page">
		<a href="#talks">Talks</a>
		<a href="#show">Lakehouse and AI Show</a>
		<a href="#books">Books</a>
		<a href="#videos">Videos</a>
		<a href="#writing">Writing</a>
		<a href="#open-source">Open source</a>
	</nav>

	<section class="container work-section" id="talks">
		<div class="work-header">
			<span class="video-label">Talks</span>
			<h2>Conference talks and sessions</h2>
		</div>
		<div class="card work-card">
			<p>Alex speaks on open lakehouse architecture, Apache Iceberg, Apache Polaris, semantic layers, and agentic AI. He has spoken at events including Data Council, Confluent Current, and DataEngBytes.</p>
			<p>Speaking topics and booking details are on alexmerced.com.</p>
			<a href="https://alexmerced.com/speaking" class="button primary" data-network-event="cta_speaking">Speaking topics and booking</a>
		</div>
	</section>

	<section class="container work-section" id="show">
		<div class="work-header">
			<span class="video-label">Video series</span>
			<h2>The Lakehouse and AI Show</h2>
		</div>
		<div class="work-grid">
			<div class="card work-card">
				<h3>Short episodes, one concept each</h3>
				<p>Most episodes run under four minutes. The series starts with OLTP versus OLAP and ETL versus ELT, works through Apache Arrow, Apache Parquet, Apache Iceberg, and Apache Polaris, then moves into language models, tokens, context windows, and prompting.</p>
				<a href="/lakehouse-ai-show/" class="button primary">Watch the episodes</a>
			</div>
			<div class="card work-card">
				<h3>The podcast</h3>
				<p>Longer conversations on data engineering, open source, and where the lakehouse is heading.</p>
				<a href="https://open.spotify.com/show/2PRDrWVpgDvKxN6n1oUsJF" target="_blank" rel="noopener noreferrer" class="button">Listen on Spotify</a>
			</div>
		</div>
	</section>

	<section class="container work-section" id="books">
		<div class="work-header">
			<span class="video-label">Books</span>
			<h2>Books on Iceberg, the lakehouse, and AI</h2>
			<p>Alex has written {bookCount} books. These are the four from O'Reilly, Manning, and Packt.</p>
		</div>
		<div class="book-grid">
			{flagshipBooks.map((book) => (
				<article class="card book-tile">
					<img src={book.cover} alt={`Cover of ${book.title}`} loading="lazy" />
					<h3><a href={`https://books.alexmerced.com/books/${book.slug}/`}>{book.title}</a></h3>
					<p class="book-publisher">{book.publisher}</p>
					<a href={book.amazon} target="_blank" rel="noopener noreferrer" class="book-buy">Buy on Amazon</a>
				</article>
			))}
		</div>
		<div class="work-more"><a href="/books/">See all {bookCount} books</a></div>
	</section>

	<section class="container video-section" id="videos">
		<div class="video-header">
			<span class="video-label">Videos</span>
			<h2>Films and the video roll</h2>
			<p>Three short music films, plus the latest uploads from the <a href="https://www.youtube.com/@alexmerceddata" target="_blank" rel="noopener noreferrer">Alex Merced Data and AI YouTube channel</a> in the <a href="/videos/">video roll</a>.</p>
		</div>
		<div class="video-grid">
			<figure class="video-figure"><div class="video-frame"><video controls preload="metadata" playsinline poster="https://alexmerced.com/my-name-is-alex-poster.jpg" aria-label="My Name Is Alex music video"><source src="https://alexmerced.com/my-name-is-alex.mp4" type="video/mp4" />Your browser does not support embedded video.</video></div><figcaption><strong>My Name Is Alex</strong><span>A personal, music-driven introduction.</span></figcaption></figure>
			<figure class="video-figure"><div class="video-frame"><video controls preload="metadata" playsinline poster="https://openagenticplatform.com/open-the-stack-poster.jpg" aria-label="Open the Stack music video"><source src="https://openagenticplatform.com/open-the-stack.mp4" type="video/mp4" />Your browser does not support embedded video.</video></div><figcaption><strong>Open the Stack</strong><span>Composable agents, open standards, portable execution.</span></figcaption></figure>
			<figure class="video-figure"><div class="video-frame"><video controls preload="metadata" playsinline poster="https://opendatalakehouse.com/the-iceberg-open-lakehouse-poster.jpg" aria-label="The Iceberg Open Lakehouse music video"><source src="https://opendatalakehouse.com/the-iceberg-open-lakehouse.mp4" type="video/mp4" />Your browser does not support embedded video.</video></div><figcaption><strong>The Iceberg Open Lakehouse</strong><span>Open data architecture from files to semantics.</span></figcaption></figure>
		</div>
	</section>

	<section class="container work-section" id="writing">
		<div class="work-header">
			<span class="video-label">Writing</span>
			<h2>Articles and newsletters</h2>
			<p>Alex writes about open tables, interoperable catalogs, and a semantic layer that gives people and agents the same governed definitions.</p>
		</div>
		<div class="work-grid">
			<div class="card work-card">
				<h3>Articles</h3>
				<p>New articles publish on Data Lakehouse Hub. The blogroll lists the latest ones and lets you search them by title.</p>
				<a href="/blogroll/" class="button primary">Search the blogroll</a>
			</div>
			<div class="card work-card">
				<h3>Weekly newsletters</h3>
				<p>An AI newsletter on Thursdays and an Apache lakehouse newsletter on Fridays, both free on Substack.</p>
				<a href="https://amdatalakehouse.substack.com/" target="_blank" rel="noopener noreferrer" class="button">Subscribe on Substack</a>
			</div>
			<div class="card work-card">
				<h3>Infographics</h3>
				<p>Architecture diagrams and explainers on the lakehouse, Apache Iceberg, Apache Polaris, Arrow, Parquet, MCP, and AI.</p>
				<a href="/gallery/" class="button">Open the gallery</a>
			</div>
		</div>
		<p class="work-note">New to the lakehouse? Start with <a href="https://opendatalakehouse.com/architecture">the independent architecture guide</a>, then try <a href="https://datalakehouse.help/">hands-on tasks</a>.</p>
	</section>

	<section class="project-section" id="open-source">
		<div class="container">
			<div class="project-intro">
				<div><span class="video-label">Current releases · September 2026</span><h2>Open data and agentic systems</h2></div>
				<p>My open-source work spans the data layer agents reason over and the portable contracts and runtimes that let them work. These are the current public releases and active development lines.</p>
			</div>
			<div class="release-grid">
				{projectUpdates.map((project) => (
					<a class="release-card" href={project.href} target="_blank" rel="noopener noreferrer">
						<div class="release-meta"><span>{project.kind}</span><strong>v{project.version}</strong></div>
						<h3>{project.name}</h3>
						<p>{project.description}</p>
						<div class="release-foot"><span>{project.status}</span><b>Explore project ↗</b></div>
					</a>
				))}
			</div>
			<div class="project-paths"><a href="https://alexmercedcoder.dev/data-tools/">Read the data-tools field guide ↗</a><a href="https://alexmercedcoder.dev/agentic/">Read the agentic-systems field guide ↗</a></div>
		</div>
	</section>

</Layout>

<style>
	.hero {
		padding: 6rem 0;
		position: relative;
		overflow: hidden;
		background: radial-gradient(circle at top right, rgba(100, 255, 218, 0.1), transparent 40%),
					linear-gradient(to bottom, var(--primary), var(--bg));
		border-bottom: 1px solid var(--secondary);
	}

	/* Pipeline DAG backdrop — desktop only */
	.hero-dag { display: none; }

	@media (min-width: 1100px) {
		.hero-dag {
			display: block;
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			pointer-events: none;
			z-index: 0;
		}
	}

	.dag-edges path {
		fill: none;
		stroke: var(--text-muted);
		stroke-width: 1;
		opacity: 0.3;
	}

	.dag-flows path {
		fill: none;
		stroke: var(--accent);
		stroke-width: 2;
		stroke-linecap: round;
		stroke-dasharray: 10 90;
		animation: dagFlow 6s linear infinite;
	}

	.dag-nodes rect {
		fill: none;
		stroke: var(--text-muted);
		stroke-width: 1.5;
		opacity: 0.4;
	}

	.dag-nodes--accent rect {
		stroke: var(--accent);
		opacity: 0.85;
		animation: dagNode 5s ease-in-out infinite;
	}

	@keyframes dagFlow {
		from { stroke-dashoffset: 100; }
		to { stroke-dashoffset: 0; }
	}

	@keyframes dagNode {
		0%, 100% { opacity: 0.35; }
		50% { opacity: 1; }
	}

	@media (prefers-reduced-motion: reduce) {
		.dag-flows path, .dag-nodes--accent rect { animation: none; }
		.dag-flows path { stroke-dashoffset: 55; }
		.dag-nodes--accent rect { opacity: 0.7; }
	}

	.hero-content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		max-width: 800px;
	}

	.hero h1 {
		font-size: clamp(2.4rem, 6vw, 4rem);
		font-weight: 800;
		margin-bottom: 0.5rem;
		background: linear-gradient(to right, var(--text), var(--accent));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}



	.bio a { color: var(--accent); }

	.jump-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		height: auto;
		padding-top: 2rem;
		padding-bottom: 0;
	}

	.jump-links a {
		color: var(--text-muted);
		text-decoration: none;
		font-weight: 500;
	}

	.jump-links a:hover { color: var(--accent); }

	.work-section {
		padding: 4rem 1.5rem 1rem;
		scroll-margin-top: 90px;
	}

	.video-section { scroll-margin-top: 90px; }

	.work-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 2.5rem;
	}

	.work-header h2 { font-size: 2.25rem; margin-bottom: 0.75rem; }
	.work-header p { font-size: 1.1rem; margin: 0; }

	.work-card {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		max-width: 800px;
		margin: 0 auto;
	}

	.work-card p { flex-grow: 1; }

	.work-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 2rem;
	}

	.work-grid .work-card { max-width: none; margin: 0; }

	.book-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.book-tile {
		display: flex;
		flex-direction: column;
	}

	.book-tile img {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		border-radius: 6px;
		margin-bottom: 1rem;
		background-color: var(--primary);
	}

	.book-tile h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
	.book-tile h3 a { color: var(--text); text-decoration: none; }
	.book-tile h3 a:hover { color: var(--accent); }
	.book-publisher { font-size: 0.9rem; margin-bottom: 1rem; flex-grow: 1; }
	.book-buy { color: var(--accent); font-weight: 600; font-size: 0.95rem; }

	.work-more, .work-note { text-align: center; margin-top: 2rem; }
	.work-more a, .work-note a, .video-header p a { color: var(--accent); font-weight: 600; }

	.subtitle {
		color: var(--accent);
		font-size: 1.5rem;
		font-weight: 500;
		margin-bottom: 1.5rem;
	}

	.bio {
		font-size: 1.2rem;
		margin-bottom: 2.5rem;
		color: var(--text-muted);
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		justify-content: center;
	}

	.video-section {
		padding: 4rem 1.5rem 1rem;
	}

	.video-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 2.5rem;
	}

	.video-label {
		display: inline-block;
		color: var(--accent);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		margin-bottom: 0.75rem;
	}

	.video-header h2 {
		font-size: 2.25rem;
		margin-bottom: 0.75rem;
	}

	.video-header p {
		color: var(--text-muted);
		font-size: 1.1rem;
		margin: 0;
	}

	.video-figure {
		max-width: 900px;
		margin: 0 auto;
	}

	.video-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
	}

	.video-frame {
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--secondary);
		background-color: var(--primary);
		box-shadow: 0 20px 50px -20px rgba(2, 12, 27, 0.9);
	}

	.video-frame video {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		background-color: var(--primary);
	}

	.video-figure figcaption {
		margin-top: 1rem;
		text-align: center;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	.video-figure figcaption strong,
	.video-figure figcaption span { display: block; }
	.video-figure figcaption strong { color: var(--text); font-size: 1.1rem; }

	.video-figure figcaption a {
		color: var(--accent);
	}


	.project-section {
		padding: 5rem 0;
		border-block: 1px solid var(--secondary);
		background: linear-gradient(145deg, rgba(100,255,218,0.07), rgba(2,12,27,0.45));
	}

	.project-intro {
		display: grid;
		grid-template-columns: 1fr minmax(300px, 520px);
		gap: 3rem;
		align-items: end;
		margin-bottom: 2.5rem;
	}

	.project-intro h2 {
		font-size: clamp(2rem, 4vw, 3.4rem);
		line-height: 1.05;
