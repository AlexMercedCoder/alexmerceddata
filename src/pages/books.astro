---
import Layout from '../layouts/Layout.astro';

import bookData from '../data/books.json';

// The catalog is generated from the entity layer; see
// alexmercedcom/scripts/build-network-booklists.mjs.
const books = bookData.books.map((b) => ({
	title: b.title,
	category: b.categorySlug,
	description: b.description,
	image: b.cover,
	link: b.amazon,
	details: b.canonicalPage,
	publisher: b.publisher,
}));
---

<Layout title="Books by Alex Merced" description={`The full library of ${books.length} books by Alex Merced covering Apache Iceberg, Data Lakehouses, AI Engineering, Economics, Fiction, and tabletop roleplaying.`}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "ItemList",
			"name": "Books by Alex Merced",
			"numberOfItems": books.length,
			"itemListElement": books.map((b, i) => ({
				"@type": "ListItem",
				"position": i + 1,
				"item": {
					"@type": "Book",
					"name": b.title,
					"author": {
						"@type": "Person",
						"name": "Alex Merced"
					},
					"url": b.details,
					"image": b.image,
					"description": b.description
				}
			}))
		})} />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@graph": [
				{
					"@type": "Book",
					"name": "Apache Iceberg: The Definitive Guide",
					"author": { "@id": "https://alexmerced.com/#alexmerced" },
					"publisher": { "@type": "Organization", "name": "O'Reilly Media" },
					"isbn": "9781098148621",
					"url": "https://www.amazon.com/dp/1098148622",
					"description": "Flagship O'Reilly guide to Apache Iceberg and modern lakehouse architecture."
				},
				{
					"@type": "Book",
					"name": "Apache Polaris: The Definitive Guide",
					"author": { "@id": "https://alexmerced.com/#alexmerced" },
					"publisher": { "@type": "Organization", "name": "O'Reilly Media" },
					"url": "https://www.amazon.com/dp/B0FBRJ7J1Y",
					"description": "Flagship O'Reilly guide to open catalogs for Iceberg lakehouses."
				},
				{
					"@type": "Book",
					"name": "Architecting an Apache Iceberg Lakehouse",
					"author": { "@id": "https://alexmerced.com/#alexmerced" },
					"publisher": { "@type": "Organization", "name": "Manning Publications" },
					"isbn": "9781633435104",
					"url": "https://www.amazon.com/dp/1633435105",
					"description": "Manning guide on architecture patterns for building Iceberg-based data platforms."
				}
			]
		})} />
	</Fragment>

	<div class="container page-header">
		<h1>Books by Alex Merced</h1>
		<p>Discover 51+ published titles spanning Apache Iceberg, Data Lakehouses, AI Engineering, Economics, and Fiction.</p>
		
		<div class="controls-container">
			<div class="search-box">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
				<input type="text" id="bookSearch" placeholder="Search books by title or keyword..." />
			</div>
			<div class="filter-tabs" id="bookCategories">
				<button class="filter-btn active" data-category="all">All ({books.length})</button>
				<button class="filter-btn" data-category="tech">Data & AI ({books.filter(b => b.category === 'tech').length})</button>
				<button class="filter-btn" data-category="economics">Economics ({books.filter(b => b.category === 'economics').length})</button>
				<button class="filter-btn" data-category="fiction">Fiction ({books.filter(b => b.category === 'fiction').length})</button>
				<button class="filter-btn" data-category="tabletop">Tabletop RPG ({books.filter(b => b.category === 'tabletop').length})</button>
			</div>
		</div>
	</div>

	<div class="container">
		<div class="books-grid" id="booksGrid">
			{books.map((book) => (
				<div 
					class="book-card card" 
					data-category={book.category} 
					data-title={book.title.toLowerCase()}
					data-description={book.description.toLowerCase()}
				>
					<div class="book-image">
						<img src={book.image} alt={book.title} loading="lazy" />
					</div>
					<div class="book-info">
						<span class="category-badge">{book.category === 'tech' ? 'Data & AI' : book.category === 'economics' ? 'Economics' : book.category === 'tabletop' ? 'Tabletop RPG' : 'Fiction'}</span>
						<h3>{book.title}</h3>
						<p>{book.description}</p>
						<p class="book-links">
							<a href={book.details} target="_blank" rel="noopener noreferrer">Details</a>
							<a href={book.link} target="_blank" rel="noopener noreferrer" class="button">Get on Amazon</a>
						</p>
					</div>
				</div>
			))}
		</div>
		<div id="noResults" class="no-results" style="display: none;">
			<p>No books found matching your search criteria.</p>
		</div>
	</div>
</Layout>

<script>
	const searchInput = document.getElementById('bookSearch') as HTMLInputElement;
	const filterBtns = document.querySelectorAll('.filter-btn');
	const cards = document.querySelectorAll('.book-card');
	const noResults = document.getElementById('noResults');

	let activeCategory = 'all';

	function filterBooks() {
		const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
		let visibleCount = 0;

		cards.forEach((card) => {
			const cat = card.getAttribute('data-category');
			const title = card.getAttribute('data-title') || '';
			const desc = card.getAttribute('data-description') || '';

			const matchesCategory = activeCategory === 'all' || cat === activeCategory;
			const matchesQuery = query === '' || title.includes(query) || desc.includes(query);

			if (matchesCategory && matchesQuery) {
				(card as HTMLElement).style.display = 'flex';
				visibleCount++;
			} else {
				(card as HTMLElement).style.display = 'none';
			}
		});

		if (noResults) {
			noResults.style.display = visibleCount === 0 ? 'block' : 'none';
		}
	}

	if (searchInput) {
		searchInput.addEventListener('input', filterBooks);
	}

	filterBtns.forEach((btn) => {
		btn.addEventListener('click', () => {
			filterBtns.forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			activeCategory = btn.getAttribute('data-category') || 'all';
			filterBooks();
		});
	});
</script>

<style>
	.page-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.page-header h1 {
		font-size: 3rem;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.page-header p {
		font-size: 1.2rem;
		color: var(--text-muted);
		max-width: 800px;
		margin: 0 auto 2.5rem;
	}

	/* Search & Filter Controls */
	.controls-container {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: center;
		max-width: 900px;
		margin: 0 auto;
	}

	.search-box {
		position: relative;
		width: 100%;
		max-width: 600px;
	}

	.search-box svg {
		position: absolute;
		left: 1rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--text-muted);
	}

	.search-box input {
		width: 100%;
		padding: 0.9rem 1rem 0.9rem 3rem;
		border-radius: 8px;
		border: 1px solid var(--secondary);
		background-color: var(--primary);
		color: var(--text);
		font-size: 1.05rem;
		outline: none;
		transition: border-color 0.3s, box-shadow 0.3s;
	}

	.search-box input:focus {
		border-color: var(--accent);
		box-shadow: 0 0 15px rgba(100, 255, 218, 0.15);
	}

	.filter-tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		justify-content: center;
	}

	.filter-btn {
		background-color: var(--secondary);
		color: var(--text-muted);
		border: 1px solid rgba(100, 255, 218, 0.1);
		padding: 0.5rem 1.25rem;
		border-radius: 9999px;
		font-size: 0.95rem;
		font-weight: 500;
		cursor: pointer;
		transition: all 0.3s ease;
	}

	.filter-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
		background-color: rgba(100, 255, 218, 0.05);
	}

	.filter-btn.active {
		background-color: var(--accent);
		color: var(--primary);
		border-color: var(--accent);
		font-weight: 600;
	}

	/* Books Grid */
	.books-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
		gap: 2.5rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.book-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		transition: transform 0.3s ease, border-color 0.3s ease;
	}

	.book-card:hover {
		transform: translateY(-6px);
		border-color: rgba(100, 255, 218, 0.4);
	}

	.book-image {
		width: 100%;
		border-radius: 6px;
		overflow: hidden;
		margin-bottom: 1.25rem;
		box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
		aspect-ratio: 3/4;
		background-color: #050d1a;
	}

	.book-image img {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.book-card:hover .book-image img {
		transform: scale(1.03);
	}

	.book-info {
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.category-badge {
		align-self: flex-start;
		background-color: rgba(100, 255, 218, 0.1);
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		margin-bottom: 0.75rem;
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.book-info h3 {
		font-size: 1.35rem;
		margin-bottom: 0.75rem;
		color: var(--text);
		line-height: 1.3;
	}

	.book-info p {
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		flex: 1;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.book-info .button {
		align-self: flex-start;
		width: 100%;
		text-align: center;
	}

	.no-results {
		text-align: center;
		padding: 4rem 1rem;
		color: var(--text-muted);
		font-size: 1.2rem;
	}

	@media (max-width: 768px) {
		.page-header h1 {
			font-size: 2.2rem;
		}
		.books-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
