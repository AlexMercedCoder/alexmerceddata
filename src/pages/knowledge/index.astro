---
import Layout from '../../layouts/Layout.astro';

// Fetch all markdown files in the knowledge directory
const allKnowledge = Object.values(import.meta.glob('./*.md', { eager: true }));
const knowledgePages = allKnowledge.sort((a, b) => new Date(b.frontmatter.date).valueOf() - new Date(a.frontmatter.date).valueOf());
---

<Layout title="Data & AI Knowledge Base" description="Authoritative articles and concepts in Data Lakehouse, Apache Iceberg, and AI.">
	<div class="container page-header">
		<h1>Knowledge Base</h1>
		<p>Explore authoritative guides, definitions, and concepts about Data Lakehouse, AI, and modern data architecture.</p>
	</div>

	<div class="container">
		<div class="kb-grid">
			{knowledgePages.map(page => (
				<a href={page.url} class="kb-card card">
					<h3>{page.frontmatter.title}</h3>
					<p class="date">{new Date(page.frontmatter.date).toLocaleDateString()}</p>
					<p class="description">{page.frontmatter.description}</p>
					<div class="tags">
						{page.frontmatter.tags && page.frontmatter.tags.map(tag => (
							<span class="tag">{tag}</span>
						))}
					</div>
				</a>
			))}
			{knowledgePages.length === 0 && <p>No knowledge base articles found.</p>}
		</div>
	</div>
</Layout>

<style>
	.page-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.page-header h1 {
		font-size: 3rem;
		color: var(--accent);
	}

	.kb-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 2rem;
		max-width: 1200px;
		margin: 0 auto;
	}

	.kb-card {
		display: flex;
		flex-direction: column;
		text-decoration: none;
	}

	.kb-card h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
		color: var(--text);
		transition: color 0.3s;
	}

	.kb-card:hover h3 {
		color: var(--accent);
	}

	.date {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin-bottom: 1rem;
	}

	.description {
		flex: 1;
		color: var(--text-muted);
		margin-bottom: 1.5rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		background-color: rgba(100, 255, 218, 0.1);
		color: var(--accent);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-size: 0.8rem;
	}
</style>
