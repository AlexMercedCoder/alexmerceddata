---
import Layout from '../layouts/Layout.astro';
import Parser from 'rss-parser';

const parser = new Parser();
let blogs = [];
try {
	const feed = await parser.parseURL('https://datalakehousehub.com/rss.xml');
	blogs = feed.items.map(item => ({
		title: item.title,
		link: item.link,
		year: new Date(item.pubDate || item.isoDate).getFullYear(),
		date: new Date(item.pubDate || item.isoDate).toLocaleDateString(),
		description: item.contentSnippet ? item.contentSnippet.substring(0, 150) + '...' : ''
	})).filter(blog => !blog.link.endsWith('/index/'));
} catch (error) {
	console.error('Error fetching blog feed:', error);
}

// Group by publication year so the page has a real section outline.
const years = [...new Set(blogs.map((b) => b.year))].sort((a, b) => b - a);
const groups = years.map((year) => ({ year, posts: blogs.filter((b) => b.year === year) }));
---

<Layout title="Writing | Searchable Blogroll | Alex Merced Data" description="Search recent articles by Alex Merced on Data Lakehouse Hub, from the RSS feed, newest first and grouped by year.">
	<div class="container page-header">
		<h1>Blogroll</h1>
		<p>Alex writes about the lakehouse, Apache Iceberg, and agentic AI on <a href="https://datalakehousehub.com">Data Lakehouse Hub</a>. Search the latest posts from the Hub feed here, newest first.</p>
		
		<div class="search-container">
			<input type="text" id="blogSearch" placeholder="Search articles by title..." />
		</div>
	</div>

	<div class="container">
		{groups.map((group) => (
			<section class="blog-year" data-year={group.year}>
				<h2>{group.year} articles <span class="year-count">({group.posts.length})</span></h2>
				<div class="blog-list">
					{group.posts.map((blog) => (
						<a href={blog.link} target="_blank" rel="noopener noreferrer" class="blog-card card" data-title={blog.title.toLowerCase()}>
							<div class="blog-info">
								<h3>{blog.title}</h3>
								<p class="date">{blog.date}</p>
								<p class="description">{blog.description}</p>
							</div>
						</a>
					))}
				</div>
			</section>
		))}
		{blogs.length === 0 && <p>No articles found or error loading feed.</p>}
	</div>
</Layout>

<script>
	const searchInput = document.getElementById('blogSearch');
	const blogCards = document.querySelectorAll('.blog-card');

	if(searchInput) {
		searchInput.addEventListener('input', (e) => {
			const term = e.target.value.toLowerCase();
			blogCards.forEach(card => {
				const title = card.getAttribute('data-title');
				if (title && title.includes(term)) {
					card.style.display = 'block';
				} else {
					card.style.display = 'none';
				}
			});
			document.querySelectorAll('.blog-year').forEach(section => {
				const visible = Array.from(section.querySelectorAll('.blog-card')).some(c => c.style.display !== 'none');
				section.style.display = visible ? '' : 'none';
			});
		});
	}
</script>

<style>
	.page-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.page-header h1 {
		font-size: 3rem;
		color: var(--accent);
	}

	.search-container {
		margin-top: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.search-container input {
		width: 100%;
		padding: 1rem;
		border-radius: 8px;
		border: 1px solid var(--secondary);
		background-color: var(--primary);
		color: var(--text);
		font-size: 1.1rem;
		outline: none;
		transition: border-color 0.3s;
	}

	.search-container input:focus {
		border-color: var(--accent);
	}

	.page-header p a { color: var(--accent); }

	.blog-year {
		max-width: 800px;
		margin: 0 auto 3rem;
	}

	.blog-year h2 {
		font-size: 1.75rem;
		margin-bottom: 1.5rem;
	}

	.year-count {
		color: var(--text-muted);
		font-weight: 400;
		font-size: 1.1rem;
	}

	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.blog-card {
		display: block;
		text-decoration: none;
		transition: transform 0.2s, border-color 0.2s;
	}

	.blog-info h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
		color: var(--text);
	}

	.blog-card:hover h3 {
		color: var(--accent);
	}

	.date {
		font-size: 0.9rem;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.description {
		color: var(--text-muted);
		margin: 0;
	}
</style>
