---
import Layout from '../layouts/Layout.astro';
import Parser from 'rss-parser';

const parser = new Parser();
let blogs = [];
try {
	const feed = await parser.parseURL('https://datalakehousehub.com/rss.xml');
	blogs = feed.items.map(item => ({
		title: item.title,
		link: item.link,
		date: new Date(item.pubDate || item.isoDate).toLocaleDateString(),
		description: item.contentSnippet ? item.contentSnippet.substring(0, 150) + '...' : ''
	})).filter(blog => !blog.link.endsWith('/index/'));
} catch (error) {
	console.error('Error fetching blog feed:', error);
}
---

<Layout title="Searchable Blogroll" description="Search through Alex Merced's articles on the Data Lakehouse Hub.">
	<div class="container page-header">
		<h1>Blogroll</h1>
		<p>Search and read articles across Data Lakehouse Hub.</p>
		
		<div class="search-container">
			<input type="text" id="blogSearch" placeholder="Search articles by title..." />
		</div>
	</div>

	<div class="container">
		<div class="blog-list" id="blogList">
			{blogs.map((blog) => (
				<a href={blog.link} target="_blank" rel="noopener noreferrer" class="blog-card card" data-title={blog.title.toLowerCase()}>
					<div class="blog-info">
						<h3>{blog.title}</h3>
						<p class="date">{blog.date}</p>
						<p class="description">{blog.description}</p>
					</div>
				</a>
			))}
			{blogs.length === 0 && <p>No articles found or error loading feed.</p>}
		</div>
	</div>
</Layout>

<script>
	const searchInput = document.getElementById('blogSearch');
	const blogCards = document.querySelectorAll('.blog-card');

	if(searchInput) {
		searchInput.addEventListener('input', (e) => {
			const term = e.target.value.toLowerCase();
			blogCards.forEach(card => {
				const title = card.getAttribute('data-title');
				if (title && title.includes(term)) {
					card.style.display = 'block';
				} else {
					card.style.display = 'none';
				}
			});
		});
	}
</script>

<style>
	.page-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.page-header h1 {
		font-size: 3rem;
		color: var(--accent);
	}

	.search-container {
		margin-top: 2rem;
		max-width: 600px;
		margin-left: auto;
		margin-right: auto;
	}

	.search-container input {
		width: 100%;
		padding: 1rem;
		border-radius: 8px;
		border: 1px solid var(--secondary);
		background-color: var(--primary);
		color: var(--text);
		font-size: 1.1rem;
		outline: none;
		transition: border-color 0.3s;
	}

	.search-container input:focus {
		border-color: var(--accent);
	}

	.blog-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.blog-card {
		display: block;
		text-decoration: none;
		transition: transform 0.2s, border-color 0.2s;
	}

	.blog-info h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
		color: var(--text);
	}

	.blog-card:hover h3 {
		color: var(--accent);
	}

	.date {
		font-size: 0.9rem;
		color: var(--accent);
		margin-bottom: 1rem;
	}

	.description {
		color: var(--text-muted);
		margin: 0;
	}
</style>
