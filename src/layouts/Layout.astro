---
import networkHead from '../../network/network-head.html?raw';
import network from '../../network/network.json';

interface Props {
	title: string;
	description?: string;
	canonicalUrl?: string;
	ogType?: string;
}

const { 
	title, 
	description = "Alex Merced's data and AI work: talks, the Lakehouse and AI Show, books, videos, and writing.",
	canonicalUrl,
	ogType = "website"
} = Astro.props;

const currentUrl = new URL(Astro.url.pathname, Astro.site);
const canonical = canonicalUrl || currentUrl.href;
const ogImage = new URL('/og-image.jpg', Astro.site).href;
const fullTitle = title.includes('|') ? title : `${title} | Alex Merced Data`;

const pageSchema = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebPage",
			"@id": `${canonical}#webpage`,
			"url": canonical,
			"name": fullTitle,
			"description": description,
			"isPartOf": { "@id": "https://alexmerceddata.com/#website" },
			"author": { "@id": "https://alexmerced.com/#alexmerced" }
		},
		{
			"@type": "WebSite",
			"@id": "https://alexmerceddata.com/#website",
			"url": "https://alexmerceddata.com",
			"name": "Alex Merced Data",
			"author": { "@id": "https://alexmerced.com/#alexmerced" },
			"publisher": { "@id": "https://alexmerceddata.com/#organization" }
		},
		{
			"@type": "Organization",
			"@id": "https://alexmerceddata.com/#organization",
			"name": "Alex Merced Data",
			"url": "https://alexmerceddata.com",
			"founder": { "@id": "https://alexmerced.com/#alexmerced" },
			"logo": { "@type": "ImageObject", "url": "https://alexmerceddata.com/favicon.png" }
		}
	]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		
		<Fragment set:html={networkHead} />

		<!-- Open Graph -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={network.twitterSite} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="canonical" href={canonical} />

		<script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />

		<title>{fullTitle}</title>
		<slot name="head" />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<header class="site-header">
			<nav class="container">
				<a href="/" class="logo">AlexMerced<span>Data</span></a>
				<ul class="nav-links" id="primary-nav">
					<li><a href="/#talks">Talks</a></li>
					<li><a href="/lakehouse-ai-show/">Lakehouse &amp; AI Show</a></li>
					<li><a href="/books/">Books</a></li>
					<li><a href="/videos/">Videos</a></li>
					<li><a href="/blogroll/">Writing</a></li>
					<li><a href="/#open-source">Open Source</a></li>
					<li><a href="/gallery/">Gallery</a></li>
				</ul>
				<button class="mobile-menu" aria-label="Toggle Menu" aria-expanded="false" aria-controls="primary-nav">
					<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
				</button>
			</nav>
		</header>

		<main id="main-content">
			<slot />
		</main>

		{network.cta && (
			<section class="cta-strip" aria-labelledby="cta-strip-heading">
				<div class="container cta-strip-inner">
					<h2 id="cta-strip-heading">{network.cta.heading}</h2>
					<ul class="cta-strip-links">
						{network.cta.links.map((link, i) => (
							<li><a href={link.url} class={i === 0 ? 'button primary' : 'button'} data-network-event={link.event}>{link.label}</a></li>
						))}
					</ul>
				</div>
			</section>
		)}

		<footer>
			<div class="container footer-content">
				<div class="footer-brand">
					<h3>AlexMerced<span>Data</span></h3>
					<p>Alex Merced's data and AI work: talks, the Lakehouse and AI Show, books, videos, and writing. For his bio and facts, visit <a href="https://alexmerced.com">alexmerced.com</a>.</p>
				</div>
				<div class="footer-links">
					<h4>On this site</h4>
					<ul>
						<li><a href="/">Home</a></li>
						<li><a href="/lakehouse-ai-show/">Lakehouse &amp; AI Show</a></li>
						<li><a href="/books/">Data &amp; AI Books</a></li>
						<li><a href="/videos/">Videos</a></li>
						<li><a href="/blogroll/">Writing</a></li>
						<li><a href="/gallery/">Infographics Gallery</a></li>
						<li><a href="/knowledge/">Knowledge Base</a></li>
					</ul>
				</div>
				<div class="footer-social">
					<h4>Connect</h4>
					<ul>
						<li><a href="https://alexmerced.com">About Alex</a></li>
						<li><a href="https://youtube.com/@alexmerceddata" target="_blank" rel="noopener noreferrer">YouTube</a></li>
						<li><a href="https://linkedin.com/in/alexmerced" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
					</ul>
				</div>
			</div>
			{network.footer.groups.map((group) => (
				<nav class="footer-run" aria-label={group.title}>
					<div class="footer-run-title">{group.title}</div>
					<ul class="footer-run-list">
						{group.links.map((link) => (
							<li><a href={link.url} target="_blank" rel="noopener">{link.title}</a></li>
						))}
					</ul>
				</nav>
			))}
			<div class="footer-run footer-all-sites">
				<a href={network.footer.allSitesUrl}>{network.footer.allSitesLabel} &rarr;</a>
			</div>
			<nav class="footer-run" aria-label="Free weekly newsletters">
			  <div class="footer-run-title">Free Weekly Newsletters</div>
			  <ul class="footer-run-list">
			    <li><a href="https://amdatalakehouse.substack.com" target="_blank" rel="noopener">AI newsletter, Thursdays</a></li>
			    <li><a href="https://amdatalakehouse.substack.com" target="_blank" rel="noopener">Apache lakehouse newsletter, Fridays</a></li>
			    <li><a href="https://amdatalakehouse.substack.com" target="_blank" rel="noopener">Subscribe on Substack</a></li>
			  </ul>
			</nav>
			<nav class="footer-run" aria-label="Events and community">
			  <div class="footer-run-title">Events &amp; Community</div>
			  <ul class="footer-run-list">
			    <li><a href="https://luma.com/agenticlakehouse" target="_blank" rel="noopener">Agentic Lakehouse Events</a></li>
			    <li><a href="https://luma.com/DataLakehouseHub" target="_blank" rel="noopener">Data Lakehouse Hub Events</a></li>
			    <li><a href="https://join.slack.com/t/thedatalakehousehub/shared_invite/zt-274yc8sza-mI2zhCW8LGkOh1uxuf8T5Q" target="_blank" rel="noopener">Data Lakehouse Hub Slack</a></li>
			    <li><a href="https://join.slack.com/t/data-events/shared_invite/zt-38vgrooy9-U9ral_gr3NAz_Siih1QwmQ" target="_blank" rel="noopener">Data Events Slack</a></li>
			    <li><a href="https://join.slack.com/t/datatechcommunity/shared_invite/zt-12xrk4qmd-y~6jUFFd7kdaLhgLURKwoA" target="_blank" rel="noopener">Data &amp; Tech Slack</a></li>
			    <li><a href="https://www.reddit.com/r/datalakehouseandai/" target="_blank" rel="noopener">r/datalakehouseandai</a></li>
			    <li><a href="https://www.linkedin.com/company/data-lakehouse-hub/" target="_blank" rel="noopener">Data Lakehouse Hub on LinkedIn</a></li>
			    <li><a href="https://www.youtube.com/@AlexMercedCoder" target="_blank" rel="noopener">Alex Merced Tech on YouTube</a></li>
			    <li><a href="https://www.youtube.com/@alexmerceddata" target="_blank" rel="noopener">Alex Merced Data &amp; AI on YouTube</a></li>
			  </ul>
			</nav>
			<div class="footer-bottom">
				<p>&copy; {new Date().getFullYear()} Alex Merced. All rights reserved.</p>
			</div>
		</footer>

		<script>
			// Mobile menu toggle
			const btn = document.querySelector('.mobile-menu');
			const links = document.querySelector('.nav-links');
			if(btn && links) {
				btn.addEventListener('click', () => {
					const isOpen = links.classList.toggle('active');
					btn.setAttribute('aria-expanded', String(isOpen));
				});
			}
		</script>
	  <!-- WebMCP: read-only tools for browser AI agents. Progressive enhancement;
       no effect where WebMCP is unsupported. Config in /webmcp/init.js -->
  <script src="/webmcp/alex-merced-webmcp.js" defer></script>
  <script src="/webmcp/init.js" defer></script>
</body>
</html>

<style is:global>
	:root {
		--primary: #0A192F;
		--secondary: #112240;
		--accent: #64FFDA;
		--text: #E6F1FF;
		--text-muted: #8892B0;
		--bg: #020C1B;
		--font-sans: 'Inter', system-ui, -apple-system, sans-serif;
	}

		/* Accessibility: skip-link + visible focus outline */
		.skip-link {
			position: absolute;
			left: -9999px;
			top: 0;
			z-index: 1000;
			padding: 0.75rem 1.25rem;
			background: var(--accent);
			color: var(--primary);
			font-weight: 600;
			text-decoration: none;
			border-radius: 0 0 6px 0;
		}
		.skip-link:focus { left: 0; }
		:focus-visible {
			outline: 3px solid var(--accent);
			outline-offset: 2px;
		}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		font-family: var(--font-sans);
		background-color: var(--bg);
		color: var(--text);
		line-height: 1.6;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	.container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 1.5rem;
	}

	main {
		flex: 1;
		padding: 4rem 0;
	}

	/* Header & Nav */
	.site-header {
		background-color: rgba(10, 25, 47, 0.85);
		backdrop-filter: blur(10px);
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: 1px solid var(--secondary);
	}

	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		height: 80px;
	}

	.logo {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--text);
		text-decoration: none;
	}

	.logo span {
		color: var(--accent);
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		list-style: none;
	}

	.nav-links a {
		color: var(--text);
		text-decoration: none;
		font-weight: 500;
		transition: color 0.3s ease;
	}

	.nav-links a:hover {
		color: var(--accent);
	}

	.mobile-menu {
		display: none;
		background: none;
		border: none;
		color: var(--accent);
		cursor: pointer;
	}

	/* Footer */
	footer {
		background-color: var(--secondary);
		padding: 4rem 0 2rem;
		border-top: 1px solid rgba(100, 255, 218, 0.1);
	}

	.footer-content {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
		gap: 2rem;
		margin-bottom: 3rem;
	}

	.footer-brand h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
	}
	.footer-brand span {
		color: var(--accent);
	}

	.footer-brand p {
		color: var(--text-muted);
	}

	.footer-links h4, .footer-social h4 {
		color: var(--text);
		margin-bottom: 1rem;
	}

	.footer-links ul, .footer-social ul {
		list-style: none;
	}

	.footer-links li, .footer-social li {
		margin-bottom: 0.5rem;
	}

	.footer-links a, .footer-social a {
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s;
	}

	.footer-links a:hover, .footer-social a:hover {
		color: var(--accent);
	}

	.footer-run {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem 1.5rem 0;
		border-top: 1px solid var(--secondary);
	}

	.footer-run-title {
		color: var(--accent);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		margin-bottom: 0.9rem;
	}

	.footer-run-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
		list-style: none;
		padding: 0;
	}

	.footer-run-list a {
		color: var(--text-muted);
		font-size: 0.9rem;
		text-decoration: none;
		transition: color 0.2s;
		max-width: 100%;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.footer-run-list a:hover { color: var(--accent); }

	.footer-run-list li + li::before {
		content: "\00B7";
		margin-right: 0.75rem;
		opacity: 0.5;
	}

	.footer-all-sites a {
		color: var(--accent);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}

	.footer-all-sites a:hover { text-decoration: underline; }

	.footer-brand p a { color: var(--accent); }

	/* CTA strip: the one primary next step, shown above the footer on every page */
	.cta-strip {
		background: linear-gradient(145deg, rgba(100, 255, 218, 0.08), rgba(2, 12, 27, 0.6));
		border-top: 1px solid var(--secondary);
		padding: 3rem 0;
	}

	.cta-strip-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.cta-strip h2 {
		font-size: 1.75rem;
		margin: 0;
	}

	.cta-strip-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		list-style: none;
	}

	@media (max-width: 640px) {
		.cta-strip-inner { flex-direction: column; align-items: stretch; text-align: center; }
		.cta-strip-links { flex-direction: column; }
		.cta-strip-links a { display: block; }
	}

	.footer-bottom {
		text-align: center;
		color: var(--text-muted);
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	/* Typography & Utilities */
	h1, h2, h3, h4 {
		color: var(--text);
		line-height: 1.2;
		margin-bottom: 1rem;
	}

	p {
		margin-bottom: 1rem;
		color: var(--text-muted);
	}

	a.button, button.cta {
		display: inline-block;
		background-color: transparent;
		color: var(--accent);
		border: 1px solid var(--accent);
		padding: 0.75rem 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		font-weight: 500;
		transition: all 0.3s ease;
		cursor: pointer;
	}

	a.button:hover, button.cta:hover {
		background-color: rgba(100, 255, 218, 0.1);
	}

	a.button.primary {
		background-color: var(--accent);
		color: var(--primary);
	}

	a.button.primary:hover {
		background-color: transparent;
		color: var(--accent);
		border-color: var(--accent);
	}

	/* Cards */
	.card {
		background-color: var(--secondary);
		border-radius: 8px;
		padding: 1.5rem;
		border: 1px solid rgba(100, 255, 218, 0.05);
		transition: transform 0.3s ease, border-color 0.3s ease;
	}

	.card:hover {
		transform: translateY(-5px);
		border-color: rgba(100, 255, 218, 0.3);
	}

	/* Responsive */
	@media (max-width: 768px) {
		.nav-links {
			display: none;
			position: absolute;
			top: 80px;
			left: 0;
			right: 0;
			background-color: var(--secondary);
			flex-direction: column;
			padding: 2rem;
			gap: 1.5rem;
			text-align: center;
			box-shadow: 0 10px 30px -10px rgba(2, 12, 27, 0.7);
		}
		
		.nav-links.active {
			display: flex;
		}

		.mobile-menu {
			display: block;
		}
	}

	/* Mobile: one item per row left a separator stranded at line start and 17px
	   tap targets. Below 640px the run items become chips instead. */
	@media (max-width: 640px) {
	  .footer-run-list { gap: 8px; }
	  .footer-run-list li + li::before { content: none !important; margin-right: 0 !important; }
	  .footer-run-list a {
	    display: block;
	    padding: 9px 12px;
	    border: 1px solid var(--secondary);
	    border-radius: 6px;
	    line-height: 1.2;
	  }
	}
</style>
